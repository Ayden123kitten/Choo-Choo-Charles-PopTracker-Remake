  "goal_item_grid": {
    "type": "array",
    "orientation": "horizontal",
    "margin": "0,0",
    "content": [
      {
        "type": "itemgrid",
        "item_margin": "10, 10",
        "h_alignment": "left",
        "rows": [
          [
            "green_egg",
            "red_egg",
            "blue_egg",
            "temple_key"
          ]
        ]
      }
    ]
  },
